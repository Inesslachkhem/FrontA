# Configuration NPM pour éviter les timeouts
registry=https://registry.npmjs.org/
timeout=120000
fetch-timeout=120000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Désactiver les audits de sécurité pendant l'installation
audit=false

# Configuration pour les builds offline
prefer-offline=true
cache-max=86400000
